<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="26dp">

        <ImageView
            android:id="@+id/ivregistro"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/fotologo"
            android:scaleType="fitCenter"
            android:contentDescription="Logo ProxiSafe IoT" />

        <TextView
            android:id="@+id/tvtitregistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Crear cuenta"
            android:textColor="#111827"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="26dp"
            android:text="Únete a ProxiSafe IoT"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/txtnomreg"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="14dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Nombre completo"
            android:backgroundTint="#D8DEE8"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:textColor="#172033"
            android:textColorHint="#64748B" />

        <EditText
            android:id="@+id/txtusureg"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="14dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Nombre de usuario"
            android:backgroundTint="#D8DEE8"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="#172033"
            android:textColorHint="#64748B" />

        <EditText
            android:id="@+id/txtemailreg"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="14dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Correo electrónico"
            android:backgroundTint="#D8DEE8"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:textColor="#172033"
            android:textColorHint="#64748B" />

        <EditText
            android:id="@+id/txtconreg"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="14dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Contraseña"
            android:backgroundTint="#D8DEE8"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="#172033"
            android:textColorHint="#64748B" />

        <EditText
            android:id="@+id/txtconfirmarreg"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Confirmar contraseña"
            android:backgroundTint="#D8DEE8"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="#172033"
            android:textColorHint="#64748B" />

        <Button
            android:id="@+id/btnregistrar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#E51F35"
            android:text="CREAR CUENTA"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvvolverlogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="8dp"
            android:text="¿Ya tienes cuenta? Iniciar sesión"
            android:textColor="#E51F35"
            android:textSize="14sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</ScrollView>