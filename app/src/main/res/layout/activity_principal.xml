<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="26dp">

        <ImageView
            android:id="@+id/ivlogin"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/fotologo"
            android:scaleType="fitCenter"
            android:contentDescription="Logo ProxiSafe IoT" />

        <TextView
            android:id="@+id/tvlogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="ProxiSafe IoT"
            android:textColor="#111827"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvdescripcion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Sistema inteligente de proximidad"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvBienvenida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:layout_marginBottom="24dp"
            android:text="Inicio de sesión"
            android:textColor="#111827"
            android:textSize="21sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/txtusu"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="16dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Usuario"
            android:backgroundTint="#D8DEE8"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="#172033"
            android:textColorHint="#64748B" />

        <EditText
            android:id="@+id/txtcon"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Contraseña"
            android:backgroundTint="#D8DEE8"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="#172033"
            android:textColorHint="#64748B" />

        <Button
            android:id="@+id/btnini"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="#E51F35"
            android:text="INICIAR SESIÓN"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvcrearcuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="8dp"
            android:text="¿No tienes cuenta? Crear cuenta"
            android:textColor="#E51F35"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</ScrollView>