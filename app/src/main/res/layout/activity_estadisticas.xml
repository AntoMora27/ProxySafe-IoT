<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="26dp">

        <ImageView
            android:id="@+id/ivestadisticas"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/fotologo"
            android:scaleType="fitCenter"
            android:contentDescription="Logo ProxiSafe IoT" />

        <TextView
            android:id="@+id/tvusuestadisticas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Bienvenido"
            android:textColor="#111827"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvtitestadisticas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="Estadísticas"
            android:textColor="#111827"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Resumen de actividad del sistema"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:text="DETECCIONES REGISTRADAS\n\n0"
            android:textColor="#111827"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:text="DISTANCIA PROMEDIO\n\n-- cm"
            android:textColor="#111827"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:text="ESTADO DEL SISTEMA\n\nSin conexión"
            android:textColor="#111827"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Button
            android:id="@+id/btnvolestadisticas"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#64748B"
            android:text="VOLVER AL MENÚ"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>